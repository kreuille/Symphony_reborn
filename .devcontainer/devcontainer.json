{
  "name": "LegoKit",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r legokit/requirements.txt",
  "postAttachCommand": "cd legokit && nohup python3 legoweb.py --host 0.0.0.0 --port 8000 > /tmp/legoweb.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "LegoKit", "onAutoForward": "openBrowser", "visibility": "private" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["legokit/README.md"] }
  }
}
